# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=test
PORT=3100
# Comma separated allow-list. Requests from any other Origin are rejected.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Prefix for every route. Swagger lives at /api/docs (outside the prefix).
API_PREFIX=api/v1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://kidzone:kidzone@localhost:5432/kidzone_test?schema=public
# Separate database used by `npm run test:e2e`. It is dropped and recreated.
TEST_DATABASE_URL=postgresql://kidzone:kidzone@localhost:5432/kidzone_test?schema=public

# ---------------------------------------------------------------------------
# Redis (BullMQ)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Minimum 32 characters each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=69977e2c98f2d21074485c9702fcffefa2902b26672e684a5a389aad1b571f87
JWT_REFRESH_SECRET=69fa6ef51fba90fa1e20eb90f732b750db9ac3592c9beef1a06744d0ff56f937
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Cookie carrying the rotating refresh token.
REFRESH_COOKIE_NAME=kz_refresh
# Set to false only for local http development.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Leave blank for host-only cookies; set to e.g. .example.com in production.
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Business defaults (seeded into the Setting table; Settings win at runtime)
# ---------------------------------------------------------------------------
BUSINESS_TIMEZONE=Asia/Dhaka
# Sales before this hour count toward the previous business day. 0..23
BUSINESS_DAY_START_HOUR=0
# 0=Sunday .. 6=Saturday. Bangladesh convention is Saturday.
WEEK_START_DAY=6
MAX_STAFF_DISCOUNT_PERCENT=10

# ---------------------------------------------------------------------------
# Throttling
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ---------------------------------------------------------------------------
# SMS
# ---------------------------------------------------------------------------
# console | http
SMS_PROVIDER=console
SMS_HTTP_URL=https://api.example-sms.com.bd/send
SMS_HTTP_METHOD=POST
SMS_HTTP_API_KEY=
SMS_HTTP_SENDER_ID=KIDZONE
# Names of the gateway's parameters, so one provider class fits SSL Wireless,
# Alpha SMS, BulkSMSBD and friends.
SMS_PARAM_API_KEY=api_key
SMS_PARAM_SENDER_ID=senderid
SMS_PARAM_PHONE=msisdn
SMS_PARAM_MESSAGE=sms
# Extra static query/body params, JSON object. e.g. {"type":"text"}
SMS_EXTRA_PARAMS={}
SMS_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
ENABLE_CRON=false
ENABLE_QUEUE=false

# ---------------------------------------------------------------------------
# Backups (03:00 Asia/Dhaka)
# ---------------------------------------------------------------------------
BACKUP_ENABLED=false
BACKUP_DIR=./backups
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_PG_RESTORE_PATH=pg_restore
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
# S3-compatible storage (Cloudflare R2, Backblaze B2, MinIO, AWS S3).
BACKUP_S3_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=kidzone/
